{
  "name": "futuro-digital-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "check": "tsx scripts/check-setup.ts",
    "db:setup": "node scripts/db-setup.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^1.19.0",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "pg": "^8.16.0",
    "playwright-core": "^1.56.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
