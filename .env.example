# =============================================================================
# Configuração Pública do Supabase (Frontend Vite)
# =============================================================================
# Copie este arquivo para ".env.local" no ambiente local:
#   copy .env.example .env.local
#
# Onde encontrar no painel do Supabase:
#   Project Settings -> Data API (Project URL)
#   Project Settings -> API Keys (anon / publishable key)
#
# ATENÇÃO DE SEGURANÇA:
# - Use APENAS a chave pública (anon ou sb_publishable_...).
# - NUNCA coloque a chave secreta (service_role ou sb_secret_...) em variáveis VITE_!
# =============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
